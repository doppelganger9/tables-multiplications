{
  "name": "tables-multiplications",
  "version": "0.0.1",
  "description": "An angular App, to learm multiplication tables",
  "private": true,
  "engines": {
    "node": ">=22 <=26",
    "npm": ">=11 <=12"
  },
  "scripts": {
    "ng": "ng",
    "prestart": "node ./build/git-info.mjs",
    "start": "ng serve",
    "prebuild": "node ./build/git-info.mjs",
    "build": "ng build",
    "test": "TZ=UTC ng test",
    "test:ci": "TZ=UTC ng test --no-watch --coverage",
    "lint": "npx eslint 'src/**/*.{js,jsx,ts,tsx,html}' --quiet --fix",
    "lint:css": "npx stylelint '**/*.css'",
    "format": "npx prettier 'src/**/*.{js,jsx,ts,tsx,html}' --write",
    "test:e2e": "start-server-and-test start http://localhost:4200 cypress:run",
    "e2e": "ng e2e",
    "cypress:open": "cypress open",
    "cypress:run": "cypress run",
    "prewc:build": "mkdir -p static/ && node ./build/git-info.mjs",
    "wc:build": "ng build tables-multiplications",
    "wc:copy-static": "cp ./dist/tables-multiplications/browser/* ./static/",
    "prewc:serve": "npm run wc:build && npm run wc:copy-static",
    "wc:serve": "npx http-server static"
  },
  "dependencies": {
    "@angular/animations": "22.1.6",
    "@angular/common": "22.1.6",
    "@angular/compiler": "22.1.6",
    "@angular/core": "22.1.6",
    "@angular/elements": "22.1.6",
    "@angular/forms": "22.1.6",
    "@angular/platform-browser": "22.1.6",
    "@angular/platform-browser-dynamic": "22.1.6",
    "@angular/router": "22.1.6",
    "@picocss/pico": "2.1.1",
    "rxjs": "7.8.2",
    "tslib": "2.8.1"
  },
  "devDependencies": {
    "@angular-eslint/builder": "22.5.0",
    "@angular-eslint/eslint-plugin": "22.5.0",
    "@angular-eslint/eslint-plugin-template": "22.5.0",
    "@angular-eslint/schematics": "22.5.0",
    "@angular-eslint/template-parser": "22.5.0",
    "@angular/build": "^22.1.8",
    "@angular/cli": "22.1.8",
    "@angular/compiler-cli": "22.1.6",
    "@angular/localize": "22.1.6",
    "@cypress/schematic": "5.0.0",
    "@eslint/eslintrc": "3.3.7",
    "@eslint/js": "10.0.1",
    "@typescript-eslint/eslint-plugin": "8.65.0",
    "@typescript-eslint/parser": "8.65.0",
    "@typescript-eslint/utils": "8.65.0",
    "@vitest/coverage-v8": "4.1.11",
    "cypress": "15.21.1",
    "eslint": "^10.0.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.6",
    "globals": "17.8.0",
    "jest-preset-angular": "16.2.0",
    "jsdom": "28.1.0",
    "local-cypress": "1.2.8",
    "prettier": "3.9.6",
    "start-server-and-test": "3.0.12",
    "stylelint": "17.14.1",
    "stylelint-config-standard": "40.0.0",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  }
}
